# Loading
# --------------------------------------------------------------------------

def _resolve_target_version(document, target_version, warnings):
    """The version to actually run: the caller's choice, or the manifest's
    own default_version when none was given.

    Auto-run (no --target-version) has to resolve to SOME concrete version
    before checks can be selected -- the manifest, not a hardcoded CLI
    constant, is the source of truth for what that should be, so the
    default can move forward (e.g. 7.0.0 -> 7.1.0) with a manifest update
    alone, no script release. Only applies when the caller passed no
    target_version at all; an explicit --target-version is never overridden.
    """
    if target_version is not None:
        return target_version
    default_version = document.get("default_version")
    if not default_version:
        warnings.append(
            "no --target-version was given and this manifest defines no "
            "default_version; no checks can be selected")
        return None
    return default_version


def _resolve_checks(document, target_version, warnings):
    """Pick the checks list for one CE version out of the "versions" map.

    EXACT key match only -- deliberately no fallback. CE skips version
    numbers on purpose, so an unknown version fails loudly with the list
    of versions that do exist, rather than silently validating against a
    neighbouring block nobody signed off on for that version.
    """
    versions = document.get("versions") or {}
    version_block = versions.get(target_version)
    if version_block is None:
        if target_version is not None:
            warnings.append(
                "Cloud Exchange {0} is not a version these check definitions "
                "cover. Available versions: {1}".format(
                    target_version, ", ".join(sorted(versions, key=_version_sort_key))))
        return []
    return version_block.get("checks", [])


def _resolve_docs(document, target_version):
    """Merge the manifest's default docs with any version-specific override.

    Returns {"install": url_or_None, "upgrade": url_or_None,
    "migrate": url_or_None} -- always all three keys, so callers never need
    a .get() with a default. A version-specific docs entry overrides the
    top-level default key-by-key (e.g. a version can override just
    "install" and still inherit the default "upgrade" link).
    """
    resolved = {mode: None for mode in _ALLOWED_DOCS_MODES}
    default_docs = document.get("docs")
    if isinstance(default_docs, dict):
        for mode, url in default_docs.items():
            if mode in resolved:
                resolved[mode] = url

    if target_version:
        version_block = (document.get("versions") or {}).get(target_version)
        if isinstance(version_block, dict):
            version_docs = version_block.get("docs")
            if isinstance(version_docs, dict):
                for mode, url in version_docs.items():
                    if mode in resolved:
                        resolved[mode] = url

    return resolved


class ManifestError(Exception):
    """A manifest could not be obtained or validated.

    Raised rather than silently proceeding with no checks: the check set
    defines what "the host is ready" means, so running with an unobtainable
    or invalid one would report a verdict the operator cannot rely on. The
    CLI turns this into an explanatory message and a non-zero exit.

    The flags select which guidance the CLI prints, since the operator action
    differs per cause:
      `integrity` -- schema validation failed, or the body wasn't valid JSON.
        Something is wrong with the manifest content itself.
      `local` -- an operator-supplied --manifest-path could not be read.
        Network/proxy advice would be nonsense here.
      `no_checks` -- the manifest loaded fine but defines nothing for the
        requested target version, so the host went unvalidated.
      neither -- the download failed: fix connectivity, or use --manifest-path.
    """

    def __init__(self, summary, detail=None, integrity=False, local=False,
                 no_checks=False):
        Exception.__init__(self, summary)
        self.summary = summary
        self.detail = detail
        self.integrity = integrity
        self.local = local
        self.no_checks = no_checks


def load(url=None, proxy=None, target_version=None):
    """Fetch the manifest over HTTPS.

    Raises ManifestError if the manifest cannot be fetched or validated.
    HTTPS transport (certificate- and hostname-verified by http_get) plus
    schema validation and the command/path allowlists in validate() are the
    trust boundary here -- there is no separate signature scheme layered on
    top, since both this script and the manifest it fetches are published
    publicly; a signature would only re-attest what TLS to the single
    trusted source (MANIFEST_URL) already establishes.
    """
    warnings = []
    manifest_url = url or MANIFEST_URL

    if manifest_host_rejection(manifest_url):
        raise ManifestError(
            "The health check definitions may only be downloaded from {0}."
            .format(", ".join(sorted(ALLOWED_MANIFEST_HOSTS))),
            detail="Requested host: {0!r}. To use a local copy instead, pass "
                   "--manifest-path.".format(
                       urllib.parse.urlsplit(manifest_url).hostname or ""),
            integrity=True)

    response = http_get(manifest_url, max_bytes=MAX_MANIFEST_BYTES, proxy=proxy)
    if not response["ok"]:
        raise ManifestError(
            "Could not download the health check definitions from {0} ({1})."
            .format(manifest_url, response["error"]))

    try:
        document = json.loads(response["body"].decode("utf-8"))
    except (ValueError, UnicodeDecodeError) as error:
        raise ManifestError(
            "The downloaded health check definitions are not valid JSON "
            "({0}).".format(error), integrity=True)

    ok, errors = validate(document)
    if not ok:
        raise ManifestError(
            "The downloaded health check definitions failed validation.",
            detail="; ".join(errors[:3]), integrity=True)

    resolved_version = _resolve_target_version(document, target_version, warnings)
    return {
        "checks": _resolve_checks(document, resolved_version, warnings),
        "source": "remote",
        "manifest_version": document.get("manifest_version"),
        "warnings": warnings,
        "docs": _resolve_docs(document, resolved_version),
        "target_version": resolved_version,
    }


def load_local(path, target_version=None):
    """Load a manifest from a local file path.

    No signature verification is performed: the operator already has trusted
    access to the file (unlike a remote fetch, there is no untrusted network
    hop to defend against). Schema validation still applies, and any failure
    raises ManifestError rather than silently falling back -- an operator who
    passed --manifest-path asked for that specific file, so quietly running a
    different check set instead would be misleading.
    """
    warnings = []
    try:
        with open(path, "rb") as handle:
            body = handle.read()
    except (IOError, OSError) as error:
        raise ManifestError(
            "Could not read the health check definitions from {0} ({1}).".format(
                path, error), local=True)

    try:
        document = json.loads(body.decode("utf-8"))
    except (ValueError, UnicodeDecodeError) as error:
        raise ManifestError(
            "The health check definitions in {0} are not valid JSON "
            "({1}).".format(path, error), integrity=True)

    ok, errors = validate(document)
    if not ok:
        raise ManifestError(
            "The health check definitions in {0} failed validation.".format(path),
            detail="; ".join(errors[:3]), integrity=True)

    resolved_version = _resolve_target_version(document, target_version, warnings)
    return {
        "checks": _resolve_checks(document, resolved_version, warnings),
        "source": "local:{0}".format(path),
        "manifest_version": document.get("manifest_version"),
        "warnings": warnings,
        "docs": _resolve_docs(document, resolved_version),
        "target_version": resolved_version,
    }

