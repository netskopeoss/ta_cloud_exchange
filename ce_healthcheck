# Current release line. Bump each release -- only the fallback when no
# version is supplied or detected. Keep it a real, shipped string: a
# "-beta.N" suffix matches no manifest entry and aborts the run.
DEFAULT_TARGET_VERSION = "7.0.0"
DEFAULT_REPORT_NAME = "ce_healthcheck_report.json"

_BANNER = """
========================================
 Netskope Cloud Exchange Health Check
 script version {0}
========================================
""".strip()


def require_root():
    """None when running as root, else an explanatory message.

    Required, not advisory: several facts (rootless `podman ps`, the
    management service's /proc/<pid>/exe, git's ownership check) are wrong
    -- confidently, not just missing -- when read unprivileged.
    """
    geteuid = getattr(os, "geteuid", None)
    if geteuid is None or geteuid() == 0:
        return None
    return ("This check must run as root, the same way setup does.\n"
            "Re-run it as:  sudo python3 ./ce_healthcheck")


def detect_mode(deployment_dir):
    """'upgrade' when this looks like an existing CE deployment."""
    compose_present = any(
        os.path.exists(os.path.join(deployment_dir, name))
        for name in ("docker-compose.yml", "podman-compose.yml")
    )
    data_present = os.path.isdir(os.path.join(deployment_dir, "data"))
    vm_marker = os.path.exists("/.cloud_exchange_vm.marker")
    if (compose_present and data_present) or vm_marker:
        return "upgrade"
    return "install"


def _read_env_vars(path):
    """Parse a dotenv-style file into a dict. Missing/unreadable -> {}."""
    values = {}
    try:
        with open(path) as handle:
            lines = handle.readlines()
    except (IOError, OSError):
        return values
    for line in lines:
        line = line.strip()
        # Some .env files are hand-edited as shell-sourceable with an
        # `export ` prefix; without stripping it the key reads as
        # "export HA_IP_LIST", silently misdetecting HA as standalone.
        if line.startswith("export "):
            line = line[len("export "):].lstrip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        values[key.strip()] = value.strip().strip('"').strip("'")
    return values


def _version_from_env_vars(values):
    for key in ("CE_VERSION", "CORE_TAG", "CURRENT_DATABASE_VERSION"):
        if key in values:
            version = extract_version(values[key])
            if version:
                return version
    return None


def _resolved_env_vars(deployment_dir):
    """Every env var setup would see, local file plus the HA shared file.

    Same resolution order as detect_installed_version(): the local .env
    first, then whatever it points at. In HA the local file is only a
    pointer, so HA_ENABLED/HA_IP_LIST live in the shared copy.
    """
    local_vars = _read_env_vars(os.path.join(deployment_dir, ".env"))
    merged = dict(local_vars)

    env_file = local_vars.get("ENV_FILE")
    location = local_vars.get("HA_NFS_DATA_DIRECTORY")
    for path in _shared_env_candidates(env_file, location, deployment_dir):
        for key, value in _read_env_vars(path).items():
            # Local values win: they are this node's own, and setup layers
            # the shared file underneath them.
            merged.setdefault(key, value)
    return merged


def detect_deployment(deployment_dir):
    """'HA' when this host is part of an HA cluster, else 'SA'.

    Mirrors setup's own is_ha determination (setup ~line 2569), which reads
    HA_ENABLED plus the presence of an HA_IP_LIST. HA_CURRENT_NODE and
    HA_NFS_DATA_DIRECTORY are additional evidence a real HA node always
    carries -- confirmed on a live HA node, whose local .env held
    HA_NFS_DATA_DIRECTORY and HA_CURRENT_NODE while a Standalone host
    carried an explicit HA_ENABLED=False.

    Returns None when nothing indicates either way (a fresh host with no
    .env at all), so the caller can apply its own default rather than
    having a guess baked in here.
    """
    values = _resolved_env_vars(deployment_dir)
    if not values:
        return None

    if str(values.get("HA_ENABLED", "")).strip().lower() == "true":
        return "HA"
    if values.get("HA_IP_LIST", "").strip():
        return "HA"
    if values.get("HA_CURRENT_NODE", "").strip():
        return "HA"
    if values.get("HA_NFS_DATA_DIRECTORY", "").strip():
        return "HA"
    if str(values.get("HA_ENABLED", "")).strip().lower() == "false":
        return "SA"
    return None


def _shared_env_candidates(env_file, location, deployment_dir):
    """Paths that may hold the real env values when the local one is a pointer."""
    candidates = []
    if env_file:
        candidates.append(env_file)
    if location:
        candidates.append(os.path.join(location, "config", ".env"))
        candidates.append(os.path.join(location, "config", ".env.ceversion"))
    candidates.append(os.path.join(deployment_dir, ".env.ceversion"))
    return candidates


def detect_installed_version(deployment_dir):
    """Best-effort read of the currently installed CE version.

    In a Standalone deployment the local .env carries CE_VERSION/CORE_TAG
    directly. In HA it does not: the local .env is a pointer file (LOCATION,
    ENV_FILE, HA_NFS_DATA_DIRECTORY, ...) with none of the version keys --
    the real values live in a shared .env on the HA NFS mount, at whichever
    path setup itself wrote to ENV_FILE. setup resolves that same path as
    f"{location}/config/.env" (see check_prerequisites() / the HA setup
    branch), falling back to a co-located .env.ceversion if the full env
    isn't found there. Mirror that resolution order rather than only ever
    reading the local file, or every HA host reports no installed version and
    silently defaults the target to the newest release line -- masking the
    upgrade-readiness question this script exists to answer.
    """
    local_path = os.path.join(deployment_dir, ".env")
    local_vars = _read_env_vars(local_path)

    version = _version_from_env_vars(local_vars)
    if version:
        return version

    # ENV_FILE is the exact path setup wrote; prefer it. HA_NFS_DATA_DIRECTORY
    # is the real NFS mount root -- NOT "LOCATION", which setup uses for an
    # unrelated .env.keys file path.
    candidates = _shared_env_candidates(
        local_vars.get("ENV_FILE"),
        local_vars.get("HA_NFS_DATA_DIRECTORY"),
        deployment_dir)

    for path in candidates:
        version = _version_from_env_vars(_read_env_vars(path))
        if version:
            return version
    return None


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="ce_healthcheck",
        description="Validate host prerequisites for Netskope Cloud Exchange.",
    )
    parser.add_argument("--mode", choices=["install", "upgrade", "migrate"],
                        help="run context (default: auto-detected; "
                             "'migrate' currently runs the same checks as "
                             "'install')")
    parser.add_argument("--deployment", choices=["SA", "HA"],
                        help="target deployment type: standalone or HA")
    parser.add_argument("--target-version",
                        help="CE version you intend to install or upgrade to")
    parser.add_argument("--deployment-dir", default=os.path.dirname(
        os.path.abspath(__file__)),
        help="CE deployment directory (default: this script's directory)")
    parser.add_argument("--manifest-url",
                        help="override the manifest URL (must be https)")
    parser.add_argument("--list-versions", action="store_true",
                        help="print the CE versions the check definitions "
                             "cover as JSON and exit, without running any "
                             "checks (used to populate a caller's version "
                             "picker)")
    parser.add_argument("--manifest-path",
                        help="load checks from a local JSON file instead of "
                        "fetching the manifest over the network (use this on "
                        "a host with no outbound internet access)")
    parser.add_argument("--report",
                        help="path for the JSON report (default: ./{0})".format(
                            DEFAULT_REPORT_NAME))
    # --non-interactive is a kept alias -- existing CI invocations pass it.
    parser.add_argument("--quiet", "--non-interactive", action="store_true",
                        dest="non_interactive",
                        help="suppress the detected-value notes (nothing is "
                             "ever prompted for)")
    parser.add_argument("--render-html", metavar="PAYLOADS_JSON",
                        help="render already-collected node payloads (see "
                             "--html for the output path) into one HTML "
                             "report and exit; used by the management server "
                             "to merge an HA cluster run")
    parser.add_argument("--html",
                        help="also write a self-contained HTML report to this "
                             "path (downloadable from the Cloud Exchange UI)")
    parser.add_argument("--json", action="store_true", dest="as_json",
                        help="emit the full report on stdout instead of text")
    return parser.parse_args(argv)


def resolve_context(args, stdin_is_tty=None):
    """Settle mode, deployment type, and target version.

    Nothing is ever prompted for: every value is either passed as a flag or
    detected from the host, so the same invocation behaves identically from a
    terminal, from CI, and from the management server. On a terminal the
    detected values are printed along with the flag that overrides each.
    """
    if stdin_is_tty is None:
        stdin_is_tty = sys.stdin.isatty()
    # Only controls whether detection is *reported*; nothing is asked either way.
    announce = (stdin_is_tty and not args.non_interactive
                and not getattr(args, 'as_json', False))

    deployment_dir = args.deployment_dir
    detected_mode = detect_mode(deployment_dir)
    detected_deployment = detect_deployment(deployment_dir)
    installed_version = detect_installed_version(deployment_dir)

    mode = args.mode
    if mode is None:
        # Detection is filesystem evidence -- a compose file plus data/, or the
        # CEasVM marker -- so report it rather than asking the operator to
        # re-enter what was just detected. --mode overrides when needed.
        mode = detected_mode
        if announce:
            print("Detected run context: {0}".format(
                "existing CE deployment (upgrade/migration)"
                if detected_mode == "upgrade" else "no CE deployment (fresh install)"))
            print("  (override with --mode install|upgrade|migrate)")

    deployment = args.deployment
    if deployment is None:
        # A fresh host with no .env has nothing to detect, so SA is correct.
        deployment = detected_deployment or "SA"
        if announce:
            print("Detected deployment type: {0}".format(
                "{0} (auto-detected)".format(deployment) if detected_deployment
                else "SA (no existing deployment detected)"))
            print("  (override with --deployment SA|HA)")

    # Left as None (not a hardcoded constant) so the manifest's own
    # "default_version" decides once it loads -- see main().
    target_version = args.target_version
    if target_version is None and announce:
        print("Target CE version: not given -- will use the manifest's "
              "default_version once it loads")
        if installed_version:
            print("  (currently installed: {0}; override with "
                  "--target-version)".format(installed_version))
        else:
            print("  (override with --target-version)")

    return {
        "mode": mode,
        "deployment": deployment,
        "target_version": target_version,
        "deployment_dir": deployment_dir,
        "detected_mode": detected_mode,
        "detected_deployment": detected_deployment,
        "installed_version": installed_version,
        # Which node produced this report. Set from the HA env when present so
        # a merged multi-node HTML report can label each section; None on SA.
        "node": _resolved_env_vars(deployment_dir).get("HA_CURRENT_NODE") or None,
        "https_proxy": os.environ.get("HTTPS_PROXY")
        or os.environ.get("https_proxy"),
    }


def _report_manifest_error(error, args):
    """Explain an unobtainable manifest and exit non-zero.

    Exit code 2 distinguishes "the health check could not run" from exit 1,
    "the health check ran and a prerequisite failed" -- a CI job needs to
    tell an infrastructure problem apart from a genuine prerequisite gap.
    """
    if args.as_json:
        json.dump({"error": error.summary, "detail": error.detail,
                   "results": [], "summary": {}},
                  sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return 2

    print("")
    print(_NOTICE_FAIL_FMT.format(error.summary))
    if error.detail:
        print("")
        print(error.detail)
    print("")
    if error.integrity:
        print("The health check cannot continue with definitions that failed "
              "verification. Contact Netskope Support if this persists.")
    elif error.no_checks:
        print("Check the version you entered. Some Cloud Exchange version "
              "numbers are skipped and never released, so a version that "
              "looks plausible may not exist. Re-run with --target-version "
              "set to one of the versions listed above, or use "
              "--list-versions to see them.")
    elif error.local:
        print("Verify that the path given to --manifest-path exists and is "
              "readable, then run the health check again.")
    else:
        print("The health check needs to download its check definitions before "
              "it can validate this host. Verify the network connectivity, "
              "proxy settings or firewall configurations to address the "
              "connectivity issues, then run the health check again.")
        print("")
        print("If this host has no outbound internet access, download "
              "checks_bundled.json separately and re-run with "
              "--manifest-path pointing at that file.")
    return 2


def _render_html_from_payloads(source_path, output_path):
    """Render already-collected node payloads into one HTML file.

    The management server collects one JSON payload per node (its own plus
    each reachable peer's) and needs a single merged report out the other
    end. It has nothing to import -- only this single self-contained script
    ships to customers -- so the rendering it needs has to be reachable
    through the script's own CLI.

    `source_path` is a JSON file holding either one payload object, or:
        {"nodes": [{"label": "Node 10.0.0.1", "payload": {...}},
                   {"label": "Node 10.0.0.2", "unreachable": true,
                    "error": "Management server unreachable"}]}

    A node entry with no payload renders as an explicit "not checked"
    section rather than being dropped, so a partial cluster run can never
    read as a clean bill of health.
    """
    try:
        with open(source_path) as handle:
            document = json.load(handle)
    except (IOError, OSError, ValueError) as error:
        sys.stderr.write("could not read payloads from {0}: {1}\n".format(
            source_path, error))
        return 2

    nodes = document.get("nodes") if isinstance(document, dict) else None
    try:
        if nodes is None:
            write_html_report(output_path, document)
        else:
            write_html_report(output_path, [
                (entry.get("label") or entry.get("node") or "Node",
                 entry.get("payload") or _unreachable_payload(entry))
                for entry in nodes
            ])
    except (IOError, OSError) as error:
        sys.stderr.write("could not write {0}: {1}\n".format(output_path, error))
        return 2
    return 0


def _unreachable_payload(entry):
    """A stand-in payload for a node that could not be checked.

    Rendered as a NOT_VERIFIED row so the operator can tell "not checked"
    apart from "checked and healthy" -- omitting the node entirely would
    make a partial run look complete.
    """
    reason = entry.get("error") or "Management server unreachable"
    return build_payload(
        {},
        [make_result("node-unreachable", Level.NOT_VERIFIED,
                     "Node health check: {0}".format(reason),
                     label="Node could not be checked",
                     remedy="This node was not included in the results. "
                            "Confirm its management server is running and "
                            "reachable, then run the health check again.")],
        {"node": entry.get("node"), "deployment": "HA",
         "unreachable": True, "error": reason},
    )


def _list_versions(args):
    """Print the target versions the manifest covers, as JSON.

    Enumerates the exact release keys in the manifest's "versions" map, so
    a caller can populate a version picker.
    """
    document = None
    error = None
    try:
        if args.manifest_path:
            with open(args.manifest_path) as handle:
                document = json.load(handle)
        else:
            # Same pin load() applies. The management server forwards an
            # admin-supplied ?manifest_url= straight into this flag, so
            # without it an arbitrary host's version keys could be echoed
            # back through the API.
            manifest_url = args.manifest_url or MANIFEST_URL
            error = manifest_host_rejection(manifest_url)
            if not error:
                response = http_get(manifest_url,
                                    max_bytes=MAX_MANIFEST_BYTES)
                if response["ok"]:
                    document = json.loads(response["body"].decode("utf-8"))
                else:
                    error = response["error"]
    except (IOError, OSError, ValueError) as exc:
        error = str(exc)


    if not isinstance(document, dict):
        # names the case where a body parsed cleanly but is not a manifest.
        error = error or "check definitions are not a JSON object"
        document = {}

    versions = []
    manifest_default = None
    if document:
        mapped = document.get("versions")
        if isinstance(mapped, dict):
            versions = sorted(mapped, key=_version_sort_key)
        manifest_default = document.get("default_version")

    # Prefer the manifest's own default_version, then the highest listed
    # version, then the built-in constant.
    default = manifest_default
    if not default:
        default = versions[-1] if versions else DEFAULT_TARGET_VERSION

    payload = {
        "versions": versions,
        "default": default,
        "manifest_version": document.get("manifest_version"),
    }
    if error:
        payload["error"] = error
    json.dump(payload, sys.stdout, indent=2, sort_keys=True, default=str)
    sys.stdout.write("\n")
    return 0 if versions or not error else 2


def _version_sort_key(text):
    """Sort version strings numerically, not lexically ("6.10" > "6.9")."""
    try:
        return parse_version(text)
    except ValueError:
        return (0, 0, 0, 0, 0)


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])

    if args.list_versions:
        return _list_versions(args)

    if args.render_html:
        if not args.html:
            sys.stderr.write(
                "--render-html requires --html <output path> to write the "
                "rendered report to.\n")
            return 2
        return _render_html_from_payloads(args.render_html, args.html)

    # Exit 2 ("could not run"), never 1 -- some checks fail confidently
    # wrong, not just missing, when read unprivileged.
    privilege_error = require_root()
    if privilege_error is not None:
        if args.as_json:
            json.dump({"error": privilege_error, "detail": None,
                       "results": [], "summary": {}},
                      sys.stdout, indent=2, sort_keys=True)
            sys.stdout.write("\n")
        else:
            print("")
            print(_NOTICE_FAIL_FMT.format(privilege_error))
        return 2

    context = resolve_context(args)

    # Validate the version string before anything else uses it: a malformed
    # one would otherwise surface as a confusing "no checks defined" instead
    # of the real problem. Exit 2 ("could not run"), not 1. Skipped when
    # target_version is None -- that's resolved from default_version below.
    if context["target_version"] is not None:
        try:
            parse_version(context["target_version"])
        except ValueError:
            return _report_manifest_error(ManifestError(
                "{0!r} is not a recognizable Cloud Exchange version string."
                .format(context["target_version"]),
                detail="Provide a version like '7.0.0', or check the versions "
                       "available with --list-versions.",
                no_checks=True), args)

    if not args.as_json:
        print(_BANNER.format(__version__))
        print("Mode:              {0}".format(context["mode"]))
        print("Deployment type:   {0}".format(context["deployment"]))
        print("Target CE version: {0}".format(
            context["target_version"] or "(resolving from manifest default)"))
        print("Deployment dir:    {0}".format(context["deployment_dir"]))
        print("")

    try:
        if args.manifest_path:
            loaded = load_local(args.manifest_path,
                                target_version=context["target_version"])
        else:
            loaded = load(url=args.manifest_url,
                          proxy=context["https_proxy"],
                          target_version=context["target_version"])
    except ManifestError as error:
        # No fallback: without a valid check set there is no
        # trustworthy verdict to report, so stop rather than imply the host
        # was assessed. Wording mirrors setup's own connectivity guidance.
        return _report_manifest_error(error, args)

    # load()/load_local() resolve None to the manifest's own default_version
    # -- adopt that value everywhere downstream instead of a stale guess.
    if context["target_version"] is None:
        resolved = loaded.get("target_version")
        if resolved is None:
            # Neither was available; fall back for manifests authored
            # before default_version existed.
            resolved = DEFAULT_TARGET_VERSION
            loaded["warnings"].append(
                "no --target-version was given and this manifest defines "
                "no default_version; falling back to the script's built-in "
                "default {0!r}".format(resolved))
        context["target_version"] = resolved
        if not args.as_json:
            print("Target CE version: {0} (from manifest default_version)"
                  .format(resolved))

    if not loaded["checks"]:
        # Zero checks is not a pass -- exiting 0 with "0 failed" would read
        # as "host is ready" when nothing was verified. Same exit code as an
        # unobtainable manifest; _resolve_checks() already listed the
        # versions that ARE available in its warning.
        detail = "; ".join(loaded["warnings"]) if loaded["warnings"] else (
            "The check definitions in use do not cover this target version, "
            "so this host was not validated.")
        return _report_manifest_error(ManifestError(
            "Cloud Exchange version {0} does not exist in these check "
            "definitions, so this host was not validated.".format(
                context["target_version"]),
            detail=detail, no_checks=True), args)

    for warning in loaded["warnings"]:
        if not args.as_json:
            print(_NOTICE_WARN_FMT.format(warning))

    host_facts = collect(context["deployment_dir"])
    # The peer list only exists at run time (HA_IP_LIST in the env), so a
    # manifest cannot enumerate it -- hand it to the engine as a fact and let
    # the ha_peer_ports check fan out across whatever nodes this cluster has.
    _ha_env = _resolved_env_vars(context["deployment_dir"])
    host_facts["ha_current_node"] = _ha_env.get("HA_CURRENT_NODE") or None
    host_facts["ha_nodes"] = [
        ip.strip() for ip in (_ha_env.get("HA_IP_LIST") or "").split(",")
        if ip.strip()
    ]
    # Let manifest checks branch on detected OS/runtime via applies_when,
    # mirroring setup's own isRedHat()/docker-then-podman-fallback branching.
    # Lowercased to match validate()'s requirement on the manifest side.
    context["os_id"] = ((host_facts.get("os") or {}).get("id") or "").lower() or None
    context["detected_runtime"] = (host_facts.get("runtime") or {}).get("runtime")
    context["is_vm"] = bool(host_facts.get("is_vm"))
    results = run_all(loaded["checks"], host_facts, context)

    if not args.as_json:
        for result in results:
            print_result(result)

    counts = summarize(results)
    code = exit_code(results)

    docs_url = None
    if code == 0 and context["mode"] in ("install", "upgrade", "migrate"):
        docs_url = (loaded.get("docs") or {}).get(context["mode"])

    report_path = args.report or os.path.join(os.getcwd(), DEFAULT_REPORT_NAME)
    meta = {
        "script_version": __version__,
        "mode": context["mode"],
        "deployment": context["deployment"],
        "target_version": context["target_version"],
        "detected_mode": context["detected_mode"],
        "detected_deployment": context["detected_deployment"],
        "installed_version": context["installed_version"],
        "deployment_dir": context["deployment_dir"],
        "node": context.get("node"),
        "manifest_source": loaded["source"],
        "manifest_version": loaded["manifest_version"],
        "manifest_warnings": loaded["warnings"],
        "docs_url": docs_url,
    }

    try:
        write_json_report(report_path, host_facts, results, meta)
        report_written = report_path
    except (IOError, OSError) as error:
        report_written = None
        if not args.as_json:
            print(_NOTICE_WARN_FMT.format(
                "could not write report: {0}".format(error)))

    html_written = None
    if args.html:
        try:
            write_html_report(
                args.html, build_payload(host_facts, results, meta))
            html_written = args.html
        except (IOError, OSError) as error:
            if not args.as_json:
                print(_NOTICE_WARN_FMT.format(
                    "could not write HTML report: {0}".format(error)))

    if args.as_json:
        json.dump({"meta": meta, "facts": host_facts, "results": results,
                   "summary": counts}, sys.stdout, indent=2, sort_keys=True,
                  default=str)
        sys.stdout.write("\n")
        return code

    print("")
    print("-" * 72)
    print("Summary: {passed} passed, {warned} warning(s), {failed} failed, "
          "{skipped} not applicable, {not_verified} not verified".format(**counts))

    # List every unverified check with its reason, so exit 0 is never
    # mistaken for "everything was checked".
    unverified = [r for r in results if r["level"] == Level.NOT_VERIFIED]
    if unverified:
        print("")
        print("Could not be verified ({0} of {1} checks):".format(
            len(unverified), counts["total"]))
        for result in unverified:
            detail = (result.get("message") or "").split(": ", 1)
            print("  - {0}: {1}".format(
                display_name(result),
                detail[1] if len(detail) > 1 else "reason not recorded"))

    all_not_verified = counts["total"] > 0 and counts["not_verified"] == counts["total"]
    if code:
        print("")
        print(_NOTICE_FAIL_FMT.format(
            "One or more prerequisite checks have failed. Please ensure the "
            "minimum system requirements are met to proceed further."))
    elif all_not_verified:
        # Nothing failed because nothing was actually checked. Folding this
        # into the WARN-tolerant "meets prerequisites" message below would
        # report a host as ready when it was never assessed at all.
        print("")
        print(_NOTICE_WARN_FMT.format(
            "None of the prerequisite checks for Cloud Exchange {0} could "
            "be verified on this host. This is not a pass -- re-run once the "
            "conditions needed to check them are in "
            "place.".format(context["target_version"])))
    elif counts["warned"] or counts["not_verified"]:
        # States how much was verified rather than asserting a broader pass.
        print("")
        print("Verified {0} of {1} checks for Cloud Exchange {2}; {3} could "
              "not be verified. No mandatory prerequisite failed. Review the "
              "items above before proceeding.".format(
                  counts["total"] - counts["not_verified"], counts["total"],
                  context["target_version"], counts["not_verified"])
              if counts["not_verified"] else
              "This host meets the mandatory prerequisites for Cloud Exchange "
              "{0}. Review the warnings above before proceeding.".format(
                  context["target_version"]))
    else:
        print("")
        print("This host meets the prerequisites for Cloud Exchange {0}.".format(
            context["target_version"]))

    if docs_url:
        print("")
        print("Refer to the Netskope documentation for the {0} procedure: "
              "{1}".format(context["mode"], docs_url))

    if report_written:
        print("")
        print("A detailed report has been saved to {0}".format(report_written))
    if html_written:
        print("An HTML report has been saved to {0}".format(html_written))
    return code


