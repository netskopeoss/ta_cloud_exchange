class Level(object):
    PASS = "PASS"
    WARN = "WARN"
    FAIL = "FAIL"
    SKIP = "SKIP"
    NOT_VERIFIED = "NOT_VERIFIED"


# ANSI sequences copied verbatim from data/management_server/utils.py:1807-1816
# so this script's output is indistinguishable from `setup`'s.
_PASS_FMT = "\033[0;32m[P] \033[0;37m{0}"
_WARN_FMT = "\033[1;93m[!] \033[0;37m{0}"
_FAIL_FMT = "\033[1;31m[F] \033[1;37m{0}\033[0;37m"
_PLAIN_FMT = "[-] {0}"

_LINE_FORMATS = {
    Level.PASS: _PASS_FMT,
    Level.WARN: _WARN_FMT,
    Level.FAIL: _FAIL_FMT,
    Level.SKIP: _PLAIN_FMT,
    Level.NOT_VERIFIED: _WARN_FMT,
}

# Whole-line notices (a manifest warning, the final verdict), as opposed to
# the per-check rows above. A warning notice keeps the "[!]" marker; the
# failure verdict drops "[F]", which belongs only on a single check's row.
_NOTICE_WARN_FMT = _WARN_FMT
_NOTICE_FAIL_FMT = "\033[1;31m{0}\033[0;37m"


# A sentinel, not None: None is itself a valid expected_label value here,
# so it can't also mean "the caller didn't set one".
_UNSET = object()


def make_result(check_id, level, message, actual=None, expected=None, remedy=None,
                label=None, check_type=None, category=None, expected_label=_UNSET):
    """Build one check result record.

    `message` is the full "<name>: <detail>" string kept for the JSON report.
    `label` is the check's name on its own; the console shows only this, so
    operator-facing output stays free of internal diagnostic text.

    `expected_label` says how a renderer should introduce `expected` --
    "minimum" for a floor, "recommended" for a soft target, "required" for
    an exact match, or None to show no explanation of `expected` at all
    (every boolean-valued check, and every check on a PASS -- a value that
    already satisfies what was expected needs no explaining). Left
    unset (the sentinel _UNSET, not None) here on purpose: run_check()
    backfills the real default centrally via _default_expected_label() the
    same way it backfills label/type/category, UNLESS a primitive passed
    this explicitly (cpu_profile does this: its two distinct FAIL cases --
    CPU count matching no profile at all vs. memory/disk below a matched
    profile's floor -- need different labels despite sharing one `type`,
    which a type-keyed table can never express). A renderer (the console,
    the HTML report, the UI) reads this field directly instead of
    maintaining its own copy of which primitive types are threshold-style
    or which levels are worth explaining, so a new check -- even one using
    a brand new primitive type -- renders correctly with no renderer-side
    change at all.
    """
    result = {
        "id": check_id,
        "level": level,
        "message": message,
        "label": label,
        # Lets a report group by what a check is about, not list them flat.
        "type": check_type,
        "category": category,
        "actual": actual,
        "expected": expected,
        "remedy": remedy,
    }
    # Only set the key when a call site passed something -- run_check()
    # tells "unset" from "explicitly None" by whether the key exists.
    if expected_label is not _UNSET:
        result["expected_label"] = expected_label
    return result


# Right-pad the name so the status words line up into a column regardless of
# check-name length, the way a status table reads rather than a log stream.
_LABEL_WIDTH = 58

# Primitive -> operator-facing group. The primitive name is an implementation
# detail ("min_resource"); the group is what an operator reads.
CHECK_CATEGORIES = {
    "min_resource": "System resources",
    "cpu_profile": "System resources",
    "runtime_detected": "System resources",
    "cpu_flag": "System resources",
    "bool_fact": "Files and packages",
    "os_supported": "Operating system",
    "version_min": "Versions",
    "version_recommended": "Versions",
    "python_version_drift": "Versions",
    "http_reachable": "Connectivity",
    "port_free": "Connectivity",
    "port_range_free": "Connectivity",
    "port_reachable": "Connectivity",
    "ha_peer_ports": "Connectivity",
    "path_exists": "Files and packages",
    "file_contains": "Files and packages",
    "file_absent": "Files and packages",
    "command_matches": "Files and packages",
    "command_output_empty": "Files and packages",
}

# Order groups are presented in: what blocks an install first, environment
# detail after.
CATEGORY_ORDER = [
    "System resources",
    "Operating system",
    "Versions",
    "Connectivity",
    "Files and packages",
    "Other",
]


def category_for(check_type):
    """Operator-facing group for a primitive type."""
    return CHECK_CATEGORIES.get(check_type, "Other")


_STATUS_WORDS = {
    Level.PASS: "PASS",
    Level.WARN: "WARNING",
    Level.FAIL: "FAILED",
    Level.SKIP: "NOT APPLICABLE",
    Level.NOT_VERIFIED: "NOT VERIFIED",
}


def display_name(result):
    """The check's name, without any appended diagnostic detail."""
    label = result.get("label")
    if label:
        return label
    # Older/handcrafted records carry only the combined string; recover the
    # name by splitting at the first ": " separator _message() inserted.
    message = result.get("message") or result.get("id") or ""
    return message.split(": ", 1)[0]


def format_line(result):
    """Render a single result as one aligned, colored console line."""
    fmt = _LINE_FORMATS.get(result["level"], _PLAIN_FMT)
    status = _STATUS_WORDS.get(result["level"], result["level"])
    name = display_name(result)
    # A manifest-supplied name longer than the column would push the status
    # word out of alignment, so truncate rather than let one long check name
    # ragged-edge the whole table.
    if len(name) > _LABEL_WIDTH:
        name = name[:_LABEL_WIDTH - 3] + "..."
    name = name.ljust(_LABEL_WIDTH, ".")
    return fmt.format("{0} {1}".format(name, status))


def print_result(result):
    """Print one result, followed by its corrective measure when present."""
    print(format_line(result))
    if result.get("remedy") and result["level"] in (Level.FAIL, Level.WARN):
        print("    {0}".format(result["remedy"]))


def summarize(results):
    """Count results by level."""
    counts = {
        "total": len(results),
        "passed": 0,
        "warned": 0,
        "failed": 0,
        "skipped": 0,
        "not_verified": 0,
    }
    key_by_level = {
        Level.PASS: "passed",
        Level.WARN: "warned",
        Level.FAIL: "failed",
        Level.SKIP: "skipped",
        Level.NOT_VERIFIED: "not_verified",
    }
    for result in results:
        key = key_by_level.get(result["level"])
        if key:
            counts[key] += 1
    return counts


def exit_code(results):
    """0 unless at least one check failed."""
    for result in results:
        if result["level"] == Level.FAIL:
            return 1
    return 0


def _utc_now_iso():
    """Current UTC time as an ISO-8601 'Z' string.

    datetime.utcnow() is deprecated on Python 3.12+ and prints a
    DeprecationWarning to stderr on every run -- visible to the operator and
    noise in a support transcript. datetime.timezone.utc exists on every
    Python this script supports (3.6+), so prefer the aware form and format
    it to the same '...Z' shape the report has always used.
    """
    stamp = datetime.datetime.now(datetime.timezone.utc)
    return stamp.replace(tzinfo=None).isoformat() + "Z"


def _restrict_permissions(path):
    """Reports embed the full host fact set; keep them 0600, best-effort."""
    try:
        os.chmod(path, 0o600)
    except (IOError, OSError):
        pass


def _open_private(path):
    """Open `path` for writing, created 0600 so it is never world-readable.

    open() creates at the umask default, leaving the full host fact set
    readable in the window before the chmod that follows the write.
    """
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    return os.fdopen(fd, "w")


def write_json_report(path, facts, results, meta):
    """Write the machine-readable report for Engineering review."""
    payload = build_payload(facts, results, meta)
    with _open_private(path) as handle:
        json.dump(payload, handle, indent=2, sort_keys=True, default=str)
        handle.write("\n")
    _restrict_permissions(path)


def build_payload(facts, results, meta):
    """The report structure shared by the JSON and HTML writers."""
    return {
        "generated_at": _utc_now_iso(),
        "meta": meta,
        "facts": facts,
        "results": results,
        "summary": summarize(results),
    }


