#!/bin/sh

set -a
. ./.env
set -e

RETRIES=5
SLEEP=3
DB_VERSION_ENV_FILE_LOCATION="./.env.ceversion"
VENV_DIR=".cevenv"
ACTIVATE_SCRIPT_PATH="${VENV_DIR}/bin/activate"
VENV_PYTHON="${VENV_DIR}/bin/python"

if [ -n "$HA_NFS_DATA_DIRECTORY" ]; then
    mounted=false
    missing_volume=false
    service_exists=false

   if systemctl list-unit-files | grep -q "^glusterd\.service"; then
    echo "glusterd service found."
    service_exists=true
        if ! systemctl is-active --quiet glusterd; then
            echo "glusterd service is not running. Attempting to start it..."
            sudo systemctl start glusterd
            for i in $(seq 1 $RETRIES); do
                if systemctl is-active --quiet glusterd; then
                    echo "glusterd service is now running."
                    break
                else
                    echo "Waiting for glusterd service... ($i/$RETRIES)"
                    sleep "$SLEEP"
                fi

                if [ "$i" -eq "$RETRIES" ]; then
                    echo "Failed to start glusterd service after $RETRIES attempts."
                fi
            done
        fi
    fi

    if $service_exists && ! gluster volume info CloudExchange | grep -q 'Volume Name: CloudExchange'; then
        echo "CloudExchange Volume not found"
        missing_volume=true
    fi

    if [ "$missing_volume" = false ]; then
        if mountpoint -q "$HA_NFS_DATA_DIRECTORY"; then
            echo "Already mounted: $HA_NFS_DATA_DIRECTORY"
            mounted=true
        else
            for i in $(seq 1 $RETRIES); do
                echo "Attempting to mount CloudExchange (try $i)..."
                if mount -t glusterfs "$HA_CURRENT_NODE:/CloudExchange" "$HA_NFS_DATA_DIRECTORY"; then
                    echo "Mount successful"
                    mounted=true
                    break
                else
                    echo "Mount attempt $i failed"
                    sleep "$SLEEP"
                fi
            done
        fi
    fi

    if [ "$missing_volume" = true ] || [ "$mounted" = false ]; then
        ENV_FILE="./.env"
    else
        if [ -f "$HA_NFS_DATA_DIRECTORY/config/.env" ]; then
            ENV_FILE="$HA_NFS_DATA_DIRECTORY/config/.env"
            DB_VERSION_ENV_FILE_LOCATION="$HA_NFS_DATA_DIRECTORY/config/.env.ceversion"
        else
            echo "Expected shared .env not found, falling back"
            ENV_FILE="./.env"
        fi
    fi
else
    ENV_FILE="./.env"
fi

. ${ENV_FILE}

# The management server prefers the interpreter of the virtual environment that
# the setup script created. This service is started by systemd with a minimal
# PATH that contains neither the virtual environment nor any interpreter the
# operator selected for this directory, so resolving python3 through PATH picks
# the system interpreter, which can be a different (and unsupported) version
# than the one the virtual environment was built with.
#
# When the virtual environment is missing we fall back to the system python3
# rather than exiting. Exiting here makes systemd restart the unit in a loop,
# and because the GlusterFS FUSE mount established above lives in this unit's
# cgroup, every one of those restarts tears the mount back down. An upgrade
# that then runs ./setup can observe /opt/shared/data unmounted and re-provision
# the volume. Staying up keeps the mount alive until setup rebuilds the venv.
#
# Caveat: under the fallback the venv is never activated, so its interpreter is
# not placed first on PATH. Child processes that resolve python3 from PATH --
# notably `./setup`, spawned by the management server via its `#!/usr/bin/env
# python3` shebang -- will use the system interpreter, which may lack the
# packages setup requires (python-dotenv, pymongo). Run setup from a shell to
# rebuild the virtual environment as soon as possible.
#
# Resolved after ENV_FILE is sourced so that no env file can override PATH
# afterwards.
if [ -f "${ACTIVATE_SCRIPT_PATH}" ] && [ -x "${VENV_PYTHON}" ]; then
    echo "Using virtual environment '${VENV_DIR}'."
    echo "Interpreter: ${VENV_PYTHON} ($("${VENV_PYTHON}" --version 2>&1))"
    # Activating it additionally puts that interpreter first on PATH, which the
    # child processes of the management server depend on: ./setup resolves
    # python3 through PATH from its shebang.
    . "${ACTIVATE_SCRIPT_PATH}"
    SERVER_PYTHON="${VENV_PYTHON}"
else
    SERVER_PYTHON="$(command -v python3 || true)"
    if [ -z "${SERVER_PYTHON}" ]; then
        echo "Virtual environment '${VENV_DIR}' is missing or incomplete ('${ACTIVATE_SCRIPT_PATH}' or '${VENV_PYTHON}' not found) and no system python3 was found on PATH. Please run setup first."
        exit 1
    fi
    echo "Virtual environment '${VENV_DIR}' is missing or incomplete ('${ACTIVATE_SCRIPT_PATH}' or '${VENV_PYTHON}' not found)."
    echo "Falling back to system interpreter: ${SERVER_PYTHON} ($("${SERVER_PYTHON}" --version 2>&1)). The GlusterFS mount stays available, but please run setup to rebuild '${VENV_DIR}'."
fi

set +a

"${SERVER_PYTHON}" data/management_server/management_server.py
